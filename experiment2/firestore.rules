rules_version = '2';

// Participants write only their own data. Researchers read through the console or the
// Admin SDK, which bypasses these rules. The same rules cover the study collections and
// their pilot_ copies.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function docPath(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }

    // ---- Participant records ----

    // Fields a participant can never change after creating the record.
    function lockedFields() {
      return ['prolificPid', 'studyId', 'sessionId', 'appVersion', 'createdAt', 'withdrawn'];
    }

    function validNewParticipant(uid, pidCol) {
      let d = request.resource.data;
      return d.prolificPid is string
        && d.studyId is string
        && d.sessionId is string
        && d.pattern == null
        && d.appOrder == null
        && d.taskOrder == null
        && d.withdrawn == false
        && d.stage == 'device'
        && d.createdAt == request.time
        // The record must belong to the Prolific ID this user claimed.
        && get(docPath(pidCol, d.prolificPid)).data.uid == uid;
    }

    // A nudged-screen pattern: three of the decision screens U1–U6, e.g. "U1U3U5".
    function validPattern(p) {
      return p is string && p.matches('^U[1-6]U[1-6]U[1-6]$');
    }

    function validAppOrder(o) {
      return o in ['bramble_first', 'stride_first'];
    }

    // Assignment cell: pattern plus app order, e.g. "U1U3U5B" (Bramble first) or "U1U3U5S".
    function cellOf(pattern, appOrder) {
      return pattern + (appOrder == 'bramble_first' ? 'B' : 'S');
    }

    // The pattern, app order and task order are set once, in the same transaction that adds 1
    // to that cell's counter in <meta>/assignment.
    function validAssignment(uid, metaCol) {
      let before = resource.data;
      let after = request.resource.data;
      let k = cellOf(after.pattern, after.appOrder);
      let meta = docPath(metaCol, 'assignment');
      return before.pattern == null
        && validPattern(after.pattern)
        && validAppOrder(after.appOrder)
        && after.taskOrder is list
        && after.taskOrder.size() == 9
        && (
          (exists(meta) && k in get(meta).data && getAfter(meta).data[k] == get(meta).data[k] + 1)
          || ((!exists(meta) || !(k in get(meta).data)) && getAfter(meta).data[k] == 1)
        );
    }

    function validParticipantUpdate(uid, metaCol) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(lockedFields())
        && (!changed.hasAny(['pattern', 'appOrder', 'taskOrder']) || validAssignment(uid, metaCol));
    }

    function participantRead(uid) {
      return isOwner(uid);
    }

    function eventCreate(uid) {
      let d = request.resource.data;
      return isOwner(uid)
        && d.type is string
        && d.clientT is number
        && d.t == request.time
        && d.keys().size() <= 40;
    }

    match /participants/{uid} {
      allow get: if participantRead(uid);
      allow create: if isOwner(uid) && validNewParticipant(uid, 'pids');
      allow update: if isOwner(uid) && validParticipantUpdate(uid, 'meta');

      match /events/{eventId} {
        allow create: if eventCreate(uid);
      }
    }

    match /pilot_participants/{uid} {
      allow get: if participantRead(uid);
      allow create: if isOwner(uid) && validNewParticipant(uid, 'pilot_pids');
      allow update: if isOwner(uid) && validParticipantUpdate(uid, 'pilot_meta');

      match /events/{eventId} {
        allow create: if eventCreate(uid);
      }
    }

    // ---- Part 2 ----
    // Same pattern as Part 1: one record per Prolific ID (claimed in <col>_pids), owner-only,
    // with fields that can't change after creation. The interview arm and its summary are
    // written only by the interviewer function (Admin SDK, which bypasses these rules), so
    // participants can neither set nor change them. The transcripts (<col>_interviews) and the
    // arm counters (part2_meta, pilot_part2_meta) have no rule here, so no browser can read or
    // write them.

    function part2Collection(col) {
      return col in ['part2', 'pilot_part2'];
    }

    function validNewPart2(col, uid) {
      let d = request.resource.data;
      return d.prolificPid is string
        && d.studyId is string
        && d.sessionId is string
        && d.withdrawn == false
        && d.stage == 'device'
        && d.get('arm', null) == null
        && d.get('interview', null) == null
        && d.createdAt == request.time
        && get(docPath(col + '_pids', d.prolificPid)).data.uid == uid;
    }

    function validPart2Update() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['prolificPid', 'studyId', 'sessionId', 'appVersion', 'createdAt', 'withdrawn', 'arm', 'interview']);
    }

    match /{col}/{uid} {
      allow get: if part2Collection(col) && isOwner(uid);
      allow create: if part2Collection(col) && isOwner(uid) && validNewPart2(col, uid);
      allow update: if part2Collection(col) && isOwner(uid) && validPart2Update();

      match /events/{eventId} {
        allow create: if part2Collection(col) && eventCreate(uid);
      }
    }

    match /{pidCol}/{pid} {
      allow get: if pidCol in ['part2_pids', 'pilot_part2_pids']
        && signedIn() && resource.data.uid == request.auth.uid;
      allow create: if pidCol in ['part2_pids', 'pilot_part2_pids'] && validPidClaim();
    }

    // ---- One record per Prolific ID ----

    function validPidClaim() {
      let d = request.resource.data;
      return signedIn()
        && d.keys().hasOnly(['uid', 'createdAt'])
        && d.uid == request.auth.uid
        && d.createdAt == request.time;
    }

    match /pids/{pid} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if validPidClaim();
    }

    match /pilot_pids/{pid} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if validPidClaim();
    }

    // ---- Balanced assignment counters ----
    // One counter per cell (nudged-screen pattern × app order). The app gives each new
    // participant the least-used cell; the rules check that exactly one counter goes up by 1
    // and that it is the caller's own new cell. (Rules can't search 40 counters for the
    // smallest, so the least-used choice itself is the app's job.)

    function assignedCell(participantCol) {
      let after = getAfter(docPath(participantCol, request.auth.uid)).data;
      return validPattern(after.pattern) && validAppOrder(after.appOrder) ? cellOf(after.pattern, after.appOrder) : '';
    }

    function validCell(k) {
      return k is string && k.matches('^U[1-6]U[1-6]U[1-6][BS]$');
    }

    function patternWasUnset(participantCol) {
      return get(docPath(participantCol, request.auth.uid)).data.pattern == null;
    }

    function validCounterCreate(participantCol) {
      let d = request.resource.data;
      let k = assignedCell(participantCol);
      return signedIn()
        && patternWasUnset(participantCol)
        && validCell(k)
        && d.keys().hasOnly([k])
        && d[k] == 1;
    }

    function validCounterUpdate(participantCol) {
      let b = resource.data;
      let a = request.resource.data;
      let k = assignedCell(participantCol);
      return signedIn()
        && patternWasUnset(participantCol)
        && validCell(k)
        && a.diff(b).affectedKeys().hasOnly([k])
        && (
          (k in b && a[k] == b[k] + 1)
          || (!(k in b) && a[k] == 1)
        );
    }

    match /meta/assignment {
      allow get: if signedIn();
      allow create: if validCounterCreate('participants');
      allow update: if validCounterUpdate('participants');
    }

    match /pilot_meta/assignment {
      allow get: if signedIn();
      allow create: if validCounterCreate('pilot_participants');
      allow update: if validCounterUpdate('pilot_participants');
    }
  }
}
