# Copy to .env.local and fill in once the Firebase project exists (Phase 12).
# Until then the app talks to the local emulators.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-bramble
VITE_FIREBASE_APP_ID=

# Prolific codes (placeholders until the study is posted)
VITE_PROLIFIC_COMPLETION_CODE=TEST-COMPLETE
VITE_PROLIFIC_RETURN_CODE=TEST-RETURN

# "true" in development: connect to the Auth and Firestore emulators
VITE_USE_EMULATORS=true

# The US map file for participants' own areas (scripts/us-map/build.sh). Unset: the default neighborhood only.
# VITE_MAP_ARCHIVE_URL=https://storage.googleapis.com/<bucket>/us.pmtiles
